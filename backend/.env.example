# Copy this file to backend/.env for local development.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Hostinger: DB_HOST is normally localhost when the API and DB share hosting.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chrisea_jewelry
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

LOG_LEVEL=info
TRUST_PROXY=false
